<Window x:Class="ApplicationView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ApplicationView.Models"
        xmlns:globalModels="clr-namespace:PrintingSlips.Models;assembly=PrintingSlips"
        mc:Ignorable="d"
        Title="Мониторинг WooCommerce и Печать Чеков" Height="680" Width="1020"
        Background="#F5F5F7"
        Closing="MainWindow_Closing">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- Левая колонка: Управление сайтами -->
            <ColumnDefinition Width="380" />
            <!-- Разделитель -->
            <ColumnDefinition Width="15" />
            <!-- Правая колонка: Логи, заказы и печать -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ЧАСТЬ: СПИСОК ХОСТИНГОВ / САЙТОВ -->
        <GroupBox Header=" Подключаемые Сайты (WordPress / WooCommerce) " Grid.Column="0" Padding="10"
                  Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Список сайтов -->
                <ListView Name="HostsListView"
                          Margin="0,0,0,10">

                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type globalModels:WooCommerceSite}">

                            <Border Padding="8">
                                <TextBlock Text="{Binding Url}" />

                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Свойства"
                                                  Click="Properties_Click"/>

                                        <MenuItem Header="Удалить"
                                                  Click="Delete_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                            </Border>

                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <!-- Форма добавления / редактирования -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Адрес сайта (URL):" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4" />
                    <!-- В WPF нет PlaceholderText, используем обычный TextBox. Текст-подсказку при необходимости делают через шаблоны -->
                    <TextBox Name="TxtSiteUrl" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,8" />

                    <TextBlock Text="Consumer Key (WooCommerce API):" FontWeight="Bold" Foreground="#333"
                               Margin="0,0,0,4" />
                    <TextBox Name="TxtConsumerKey" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,8" />

                    <TextBlock Text="Consumer Secret:" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4" />
                    <TextBox Name="TxtConsumerSecret" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,8" />

                    <!-- Кнопки CRUD -->
                    <UniformGrid Columns="3" Margin="0,10,0,0" Height="35">
                        <Button Name="BtnAdd" Content="Добавить" Margin="2" Background="#4CAF50" Foreground="White"
                                FontWeight="Bold" />
                        <Button Name="BtnEdit" Content="Изменить" Margin="2" Background="#FFC107" Foreground="Black"
                                FontWeight="Bold" />
                        <Button Name="BtnDelete" Content="Удалить" Margin="2" Background="#F44336" Foreground="White"
                                FontWeight="Bold" />
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ПРАВАЯ ЧАСТЬ: МОНИТОРИНГ И ЧЕКИ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <!-- Верхняя панель управления -->
                <RowDefinition Height="Auto" />
                <!-- Лог обновления/заказов -->
                <RowDefinition Height="*" />
                <!-- Панель печати чеков -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Панель запуска прослушивания -->
            <Border Background="#E0F7FA" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Статус службы: " VerticalAlignment="Center" FontWeight="Bold" />
                    <TextBlock Name="LblStatus" Text="Остановлен" VerticalAlignment="Center" Foreground="Red"
                               Margin="0,0,20,0" />
                    <TextBlock Text="Интервал, мин:" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBox Name="TxtPollMinutes" Text="1" Width="32" Height="26"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             Margin="0,0,10,0" />
                    <Button Name="BtnStartListen" Content="Запустить опрос" Width="130" Height="30" Margin="0,0,5,0"
                            Background="#2196F3" Foreground="White" />
                    <Button Name="BtnStopListen" Content="Остановить" Width="100" Height="30" Background="#78909C"
                            Foreground="White" />
                </StackPanel>
            </Border>

            <!-- Лента обновлений (Новые заказы WooCommerce) -->
            <GroupBox Header=" Лента новых заказов / Обновления " Grid.Row="1" Padding="5" Background="White">
                <DataGrid Name="OrdersDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding OrderDate}" Width="110" />
                        <DataGridTextColumn Header="Сайт" Binding="{Binding SiteUrl}" Width="130" />
                        <DataGridTextColumn Header="№ Заказа" Binding="{Binding OrderId}" Width="70" />
                        <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="120" />
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount}" Width="90" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                        <DataGridTextColumn Header="Печать" Binding="{Binding PrintError}" Width="*" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Повторить печать" Click="BtnPrintSelected_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </GroupBox>

            <!-- Секция принтера и чеков -->
            <GroupBox Header=" Управление печатью чеков " Grid.Row="2" Margin="0,10,0,0" Padding="15"
                      Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Колонка для текста "Выбор принтера" и Чекбокса -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Колонка под сам ComboBox выборщика -->
                        <ColumnDefinition Width="*" />
                        <!-- Колонка под кнопку Настроить поля -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Изолированная правая колонка для оранжевой кнопки -->
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <!-- СТРОКА 1: Чекбокс (занимает три левые колонки, чтобы не пересекаться с оранжевой кнопкой) -->
                    <CheckBox Name="ChkAutoPrint" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                              Content="Печатать чеки автоматически при поступлении заказа"
                              VerticalAlignment="Center" Margin="0,0,0,15" />

                    <!-- СТРОКА 2: Текст "Выбор принтеров чеков:" -->
                    <TextBlock Text="Принтеры и ширина ленты:" Grid.Row="1" Grid.Column="0"
                               VerticalAlignment="Top" Margin="0,5,10,0" />

                    <!-- СТРОКА 2: Список принтеров с настройками -->
                    <ListBox Name="LstPrinters" Grid.Row="1" Grid.Column="1"
                             MaxHeight="140" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PrinterSettingsItem}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="5,0,8,0" FontWeight="SemiBold" />
                                    <ComboBox Width="90" Height="22" Margin="0,0,8,0"
                                              ItemsSource="{Binding ConnectionTypes}"
                                              SelectedItem="{Binding ConnectionType, Mode=TwoWay}"/>
                                    <TextBox Width="90" Height="22" Margin="0,0,4,0"
                                             ToolTip="IP для NET"
                                             Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"/>
                                    <TextBox Width="42" Height="22" Margin="0,0,8,0"
                                             ToolTip="Порт (9100)"
                                             Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="Ширина:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding PaperWidthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="40" Height="22" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="мм" VerticalAlignment="Center" Foreground="#666" Margin="3,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    

                    <!-- НОВЫЙ БЛОК: Контейнер в правой колонке (занимает обе строки) -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
        
                        <!-- Оранжевая кнопка (теперь без Grid.Row, так как она внутри StackPanel) -->
                        <Button Name="BtnPrintSelected" 
                                Content="Печать чека вручную" 
                                Width="180" Height="45" 
                                Background="#FF9800" Foreground="White" FontWeight="Bold" BorderThickness="0" />
        
                        <!-- Кнопка «Настроить поля» (всегда прижата к левому краю оранжевой кнопки) -->
                        <Button Name="BtnConfigureReceipt" Content="⚙️ Настроить поля"
                                Width="180" Height="26" Background="#E0E0E0" BorderThickness="1" Margin="0,8,0,0"
                                Click="BtnConfigureReceipt_Click"/>
                        <Button Name="BtnAddNetworkPrinter" Content="Добавить NET (IP)"
                                Width="180" Height="26" Margin="0,8,0,0" Click="BtnAddNetworkPrinter_Click"/>
                        <Button Name="BtnTestPrint" Content="Тест печати"
                                Width="180" Height="26" Margin="0,8,0,0" Click="BtnTestPrint_Click"/>
                        <Button Name="BtnCompanySettings" Content="Реквизиты продавца"
                                Width="180" Height="26" Margin="0,8,0,0" Click="BtnCompanySettings_Click"/>
                   
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>