<Window x:Class="ApplicationView.AddNetworkPrinterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сетевой принтер (NET)" Height="280" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="Имя:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox Name="TxtName" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,0,8"
                 VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Text="IP / хост:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox Name="TxtHost" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,0,0,8"
                 VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Text="Порт:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox Name="TxtPort" Grid.Row="2" Grid.Column="1" Height="26" Margin="0,0,0,8"
                 Text="9100" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="3" Text="Ширина, мм:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox Name="TxtWidth" Grid.Row="3" Grid.Column="1" Height="26" Margin="0,0,0,8"
                  SelectedIndex="1">
            <ComboBoxItem Content="58"/>
            <ComboBoxItem Content="80"/>
        </ComboBox>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Добавить" Width="90" Height="28" IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
