<Window x:Class="ApplicationView.CompanySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реквизиты продавца" Height="420" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="Заголовок / продавец" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SellerTitle, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>
                <TextBlock Text="ФИО" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SellerName, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>
                <TextBlock Text="ИНН" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Inn, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>
                <TextBlock Text="Менеджер по умолчанию" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Manager, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>
                <TextBlock Text="Канал продаж" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SalesChannel, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>
                <TextBlock Text="Подпись: груз сдал" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SignReleased, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>
                <TextBlock Text="Подпись: груз принял" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SignReceived, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>
                <TextBlock Text="Подвал чека" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Footer, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Отмена" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Сохранить" Width="110" Height="28" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
