<Window x:Class="ApplicationView.ReceiptSettingsWindow"
        xmlns:services="clr-namespace:ApplicationView.Services"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ApplicationView"
        xmlns:globalModels="clr-namespace:PrintingSlips.Models;assembly=PrintingSlips"
        mc:Ignorable="d"
        Title="Настройка шаблона чека" Height="580" Width="850"
        d:DataContext="{d:DesignInstance Type=local:ReceiptSettingsWindow, IsDesignTimeCreatable=False}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ЗАГОЛОВОК И ВЫБОР ПРИНТЕРА -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="5" Padding="12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⚙️ Настройка структуры чека"
                           Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />

                <!-- Выбор принтера -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Шрифт шаблона:" Foreground="#ECF0F1" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="FontFamily на весь шаблон; размер 1–3 — у каждой строки ниже"/>
                    <ComboBox Name="CmbFontFamily" Width="150" Height="28" Margin="0,0,14,0"
                              VerticalContentAlignment="Center"
                              IsEditable="True"
                              ItemsSource="{x:Static services:FontCatalog.Families}"
                              SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="🖨️ Принтер:" Foreground="#ECF0F1" FontSize="13" 
                               VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Name="CmbPrinters" Width="200" Height="28" 
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding InstalledPrinters}"
                              SelectedItem="{Binding SelectedPrinter, UpdateSourceTrigger=PropertyChanged}"
                              SelectionChanged="CmbPrinters_SelectionChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ОСНОВНОЙ БЛОК -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <!-- СПИСОК ПОЛЕЙ ЧЕКА -->
            <ListBox Name="LstReceiptFields" Grid.Column="0" Background="White" Padding="5"
                     ItemsSource="{Binding ReceiptFields}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="globalModels:ReceiptField">
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8" Margin="0,2" Background="#FAFAFA">
                            <StackPanel>
                                <!-- Главная строка поля -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="☰" FontSize="16" Foreground="#95A5A6" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <!-- Имя поля -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Заголовок на чеке:" FontSize="11" Foreground="#7F8C8D" />
                                        <TextBox Height="26" VerticalContentAlignment="Center"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="➔" FontSize="16" Foreground="#BDC3C7"
                                               VerticalAlignment="Center" Margin="0,12,10,0" />

                                    <!-- Выбор источника данных -->
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Данные из WooCommerce / Разделитель:" FontSize="11" Foreground="#7F8C8D" />
                                        <ComboBox Height="26" VerticalContentAlignment="Center"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectedValue="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.MainWooCommerceOptions, RelativeSource={RelativeSource AncestorType=Window}}">
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Кнопка прямого удаления поля из строки -->
                                    <Button Grid.Column="4" Content="❌" Width="26" Height="26"
                                            ToolTip="Удалить это поле"
                                            Margin="8,12,0,0" Background="#FEE2E2" Foreground="#DC2626"
                                            BorderBrush="#FCA5A5" BorderThickness="1"
                                            Click="BtnRemoveFieldItem_Click" FontWeight="Bold" />
                                </Grid>

                                <!-- Дополнительные настройки строки: шрифт, отступ, 2 колонки, выравнивание -->
                                <StackPanel Orientation="Horizontal" Margin="25,6,0,0">
                                    <TextBlock Text="Шрифт (1-3):" VerticalAlignment="Center" FontSize="11" Foreground="#7F8C8D" />
                                    <TextBox Width="30" Height="24" Margin="4,0,8,0"
                                             Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Жирный" VerticalAlignment="Center" Margin="0,0,8,0"
                                              IsChecked="{Binding IsBold, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="В 2 колонки (значение справа)" VerticalAlignment="Center" Margin="0,0,10,0"
                                              ToolTip="Метка слева, а данные прижаты к правому краю чека"
                                              IsChecked="{Binding IsRow, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Отступ снизу (pt):" VerticalAlignment="Center" FontSize="11" Foreground="#7F8C8D" />
                                    <TextBox Width="30" Height="24" Margin="4,0,10,0"
                                             ToolTip="Межстрочный интервал / дополнительный вертикальный отступ в pt"
                                             Text="{Binding LineSpacing, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Выравнивание:" VerticalAlignment="Center" FontSize="11" Foreground="#7F8C8D" Margin="4,0,0,0" />
                                    <ComboBox Width="95" Height="24" Margin="4,0,0,0" SelectedValuePath="Tag"
                                              SelectedValue="{Binding Align, UpdateSourceTrigger=PropertyChanged}" ToolTip="Выравнивание">
                                        <ComboBoxItem Content="Слева" Tag="Left" />
                                        <ComboBoxItem Content="По центру" Tag="Center" />
                                        <ComboBoxItem Content="Справа" Tag="Right" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Настройки для статического текста -->
                                <StackPanel Orientation="Horizontal" Margin="25,6,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Key}" Value="static.text">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Текст:" VerticalAlignment="Center" FontSize="11" Foreground="#7F8C8D" />
                                    <TextBox Width="320" Height="24" Margin="6,0,0,0"
                                             Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <!-- КОНТЕЙНЕР ДЛЯ ШАБЛОНА ТОВАРА (block.items) -->
                                <Border Margin="25,10,0,5" Padding="10" Background="#F0F4F8" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Key}" Value="block.items">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📦 Формат вывода заказов:" 
                                                       FontWeight="Bold" FontSize="11" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox Grid.Column="1" Height="26" SelectedValuePath="Tag"
                                                      SelectedValue="{Binding ItemDisplayMode, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="Таблица (как в накладной: Название, К-во x Цена = Сумма)" Tag="Table" />
                                                <ComboBoxItem Content="Кухня (как на кухне: Название + Кол-во)" Tag="Kitchen" />
                                                <ComboBoxItem Content="По списку параметров ниже" Tag="List" />
                                            </ComboBox>
                                        </Grid>

                                        <TextBlock Text="📋 Параметры единицы товара (можно удалять и добавлять поля):" 
                                                   FontSize="11" Foreground="#475569" Margin="0,0,0,6"/>

                                        <!-- Вложенный список полей товара -->
                                        <ItemsControl ItemsSource="{Binding ChildFields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="globalModels:ReceiptField">
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0" Height="24" Margin="0,0,5,0"
                                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                                        <ComboBox Grid.Column="1" Height="24" Margin="0,0,5,0"
                                                                  SelectedValuePath="Key"
                                                                  DisplayMemberPath="Value"
                                                                  SelectedValue="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                                  ItemsSource="{Binding DataContext.ItemWooCommerceOptions, RelativeSource={RelativeSource AncestorType=Window}}" />

                                                        <Button Grid.Column="2" Content="❌" Width="24" Height="24"
                                                                ToolTip="Удалить этот параметр товара"
                                                                Click="BtnRemoveSubField_Click" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1" />
                                                        <TextBox Grid.Column="3" Width="30" Height="24" Margin="5,0,0,0" ToolTip="Размер шрифта"
                                                             Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ComboBox Grid.Column="4" Width="85" Height="24" Margin="5,0,0,0" SelectedValuePath="Tag"
                                                                  SelectedValue="{Binding Align, UpdateSourceTrigger=PropertyChanged}" ToolTip="Выравнивание">
                                                            <ComboBoxItem Content="Слева" Tag="Left" />
                                                            <ComboBoxItem Content="По центру" Tag="Center" />
                                                            <ComboBoxItem Content="Справа" Tag="Right" />
                                                        </ComboBox>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ Добавить параметр товара" Click="BtnAddSubField_Click"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,3"
                                                Background="#475569" Foreground="White" BorderThickness="0" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- УПРАВЛЕНИЕ -->
            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Top">
                <Button Name="BtnAddField" Content="➕ Добавить поле" Height="30" Margin="0,0,0,6" Background="#3498DB"
                        Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnAddField_Click" />

                <Button Name="BtnAddDashedSeparator" Content="➕ Пунктир" Height="30" Margin="0,0,0,6" Background="#2563EB"
                        Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="BtnAddDashedSeparator_Click"
                        ToolTip="Вставить пунктирную строку-разделитель" />

                <Button Name="BtnAddSpacer" Content="␣ Пустой отступ" Height="30" Margin="0,0,0,15" Background="#64748B"
                        Foreground="White" BorderThickness="0" Click="BtnAddSpacer_Click"
                        ToolTip="Вставить строку-отступ между блоками" />

                <TextBlock Text="Порядок поля:" FontSize="12" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5" />
                <Button Name="BtnMoveUp" Content="▲ Выше" Height="28" Margin="0,0,0,5" Background="#ECF0F1"
                        BorderBrush="#BDC3C7" Click="BtnUp_Click" />
                <Button Name="BtnMoveDown" Content="▼ Ниже" Height="28" Margin="0,0,0,10" Background="#ECF0F1"
                        BorderBrush="#BDC3C7" Click="BtnDown_Click" />

                <Button Name="BtnRemoveField" Content="❌ Удалить поле" Height="28" Margin="0,0,0,15" Background="#E74C3C"
                        Foreground="White" BorderThickness="0" Click="BtnDelete_Click" />

                <TextBlock Text="Сброс шаблона:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,5,0,4" />
                <Button Name="BtnResetInvoice" Content="🔄 Накладная 58мм" Height="26" Margin="0,0,0,5"
                        Background="#F1F5F9" BorderBrush="#CBD5E1" Click="BtnResetToInvoice_Click"
                        ToolTip="Загрузить структуру стандартной накладной (58 мм) с таблицей заказов" />
                <Button Name="BtnResetKitchen" Content="🔄 Кухня 80мм" Height="26"
                        Background="#F1F5F9" BorderBrush="#CBD5E1" Click="BtnResetToKitchen_Click"
                        ToolTip="Загрузить структуру стандартного кухонного чека (80 мм)" />
            </StackPanel>
        </Grid>

        <!-- КНОПКИ -->
        <Border Grid.Row="2" Background="#EAEDED" Margin="0,15,0,0" Padding="10" CornerRadius="5">
            <Grid>
                <TextBlock Text="* Шаблон товара определит, какие свойства будут выведены для каждого элемента из line_items."
                           VerticalAlignment="Center" FontSize="11" Foreground="#7F8C8D" FontStyle="Italic" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="BtnCancel" Content="Отмена" Width="90" Height="30" Margin="0,0,8,0"
                            Background="#95A5A6" Foreground="White" BorderThickness="0" />
                    <Button Name="BtnSave" Content="Сохранить" Width="150" Height="30" Background="#2ECC71"
                            Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>